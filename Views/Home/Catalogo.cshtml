@model IEnumerable<PROGxefsi.Models.OrganizationViewModel>
@{
    ViewData["Title"] = "Catálogo";
}

<div class="container my-4">
    <h1 class="mb-3">Catálogo de organizaciones</h1>
    <p class="text-muted">Listado en grilla de organizaciones o causas.</p>

    <div class="row mb-3">
        @foreach(var org in Model)
        {
            <div class="col-md-4">
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@org.Name</h5>
                        <p class="card-text">@org.ShortDescription</p>
                        <p class="text-muted small">@org.Location</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-3">
        <img src="~/Catalogo.png" class="img-fluid border" alt="Captura catálogo" />
    </div>
</div>
