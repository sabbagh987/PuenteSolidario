@{
    ViewData["Title"] = "Detalle - Organización";
}

<div class="container my-4">
    <h1 class="mb-3">Organización — Detalle</h1>
    <p class="text-muted">Ficha detallada de la organización con su ubicación en el mapa.</p>

    <div class="row">
        <div class="col-md-6">
            <h2 class="h5">Nombre de la organización</h2>
            <p>Descripción corta.</p>
            <div class="mb-3">
                <button class="btn btn-primary">Donar</button>
                <button class="btn btn-outline-secondary">Contactar</button>
            </div>
        </div>
        <div class="col-md-6">
            <img src="~/Mapa De Organizaciones Especifico.png" class="img-fluid border" alt="Mapa detalle" />
        </div>
    </div>
</div>
