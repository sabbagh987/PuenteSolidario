@model PROGxefsi.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Home - Usuario";
}

<div class="container my-4">
    <h1 class="mb-3">Home (usuario: @Model.Name)</h1>
    <p class="text-muted">Versión de la home para usuarios autenticados. Estructura de ejemplo basada en la captura.</p>

    <div class="row">
        <div class="col-lg-8">
            <section class="mb-4">
                <h2 class="h5">Actividades destacadas</h2>
                <div class="card-deck">
                    <div class="card p-3 mb-3">
                        <div class="card-body">Tarjeta de ejemplo</div>
                    </div>
                    <div class="card p-3 mb-3">
                        <div class="card-body">Tarjeta de ejemplo</div>
                    </div>
                </div>
            </section>

            <section>
                <h2 class="h5">Últimas donaciones</h2>
                <ul class="list-group">
                    <li class="list-group-item">Donación 1</li>
                    <li class="list-group-item">Donación 2</li>
                </ul>
            </section>
        </div>
        <div class="col-lg-4">
            <aside>
                <h3 class="h6">Panel</h3>
                <div class="card mb-3">
                    <div class="card-body">Resumen de usuario</div>
                </div>
                <img src="~/Home una vez logeado.png" class="img-fluid border" alt="Home usuario" />
            </aside>
        </div>
    </div>
</div>
