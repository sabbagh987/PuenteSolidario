@{
    ViewData["Title"] = "Crear Organización";
}

<div class="container my-4">
    <h1 class="mb-3">Crear organización</h1>
    <p class="text-muted">Formulario para registrar una nueva organización.</p>

    <div class="row">
        <div class="col-md-6">
            <form>
                <div class="mb-3">
                    <label class="form-label">Nombre de la organización</label>
                    <input class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea class="form-control" rows="4"></textarea>
                </div>
                <button class="btn btn-primary">Crear organización</button>
            </form>
        </div>
        <div class="col-md-6">
            <img src="~/Crear Organizacion.png" class="img-fluid border" alt="Crear organización" />
        </div>
    </div>
</div>
