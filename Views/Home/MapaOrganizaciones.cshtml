@{
    ViewData["Title"] = "Mapa de Organizaciones";
}

<div class="container my-4">
    <h1 class="mb-3">Mapa de Organizaciones</h1>
    <p class="text-muted">Vista con mapa general de organizaciones.</p>

    <div class="row">
        <div class="col-md-8">
            <div class="border" style="height:400px; display:flex; align-items:center; justify-content:center;">
                <!-- Placeholder para mapa -->
                <span class="text-muted">Mapa interactivo (placeholder)</span>
            </div>
        </div>
        <div class="col-md-4">
            <h3 class="h6">Filtros</h3>
            <form>
                <div class="mb-2">
                    <input class="form-control" placeholder="Buscar" />
                </div>
                <div class="mb-2">
                    <select class="form-select"><option>Todos</option></select>
                </div>
            </form>
            <img src="~/Mapa De Organizaciones.png" class="img-fluid border mt-3" alt="Mapa" />
        </div>
    </div>
</div>
